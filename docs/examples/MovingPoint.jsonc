
{
	"type": "Feature",
	"geometry": {
		"type": "Point", // name officially used in geoJSON
		"coordinates": ["X", "Y", "Z"], // Position (ICRS coords) // name officially used in geoJSON
		"velocity": {
      "type": "Orbit", // epoch orbit | linear
      "center": [Xc, Yc, Zc],        // parent body position at epoch
      "elements": {
        "a": 1.0,                   // semi-major axis
        "e": 0.0167,                // eccentricity
        "i": 0.00005,               // inclination (radians or degrees)
        "Omega": 348.739,           // ascending node
        "omega": 114.207,           // argument of periapsis
        "M0": 0.0                   // mean anomaly at epoch
      }
  }
	},
	"properties": {
		// Examples - properties are non-standard e.g., geoJSON
		"name": "Galactic Centre",
		"M": "J2000", // Reference time (epoch) // informally used for geoJSON
		"type": "star",
		"mass": 1.1,
		"spectral_class": "G2V"
	}
}
