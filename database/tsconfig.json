{
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": false,
		"moduleResolution": "bundler",
		"paths": {
			"$data/*": ["./data/*"],
			"$types/*": ["../types/*"]
		}
	},
	"include": [
		"*.ts",
		"**/*.ts",
		"*.d.ts",
		"**/*.d.ts",
		"../types/*.d.ts",
		"../types/**/.d.ts"
	]
}
